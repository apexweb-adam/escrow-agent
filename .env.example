# Leave PAYPAL_* empty to run in mock mode (full flow, no network calls).
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Any OpenAI-compatible chat completions endpoint. Empty key = deterministic mock AI.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
APP_BASE_URL=http://localhost:3000
